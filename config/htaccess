# CITGROUP Dental Studio — Hostinger / LiteSpeed server config
#
# DEPLOY THIS FILE AS `public_html/.htaccess` ON EVERY REDEPLOY.
# It is NOT part of the Next.js static export (it cannot be — the export has no
# knowledge of the host), so it lives here in the repo as the source of truth
# and must be uploaded by hand. The repo copy exists because an earlier version
# of this file only ever existed in a local temp folder and was unreproducible.
#
#   1. AddType for .avif / .webp   — LOAD-BEARING. Without it Hostinger serves
#      .avif as text/plain, so <picture> sources fail to decode and the browser
#      falls back to the .webp (or nothing). Do not remove.
#   2. Immutable caching             — everything matched below is either
#      content-hash fingerprinted or never changes under the same name, so a
#      one-year immutable cache is safe.
#
# SOURCE OF TRUTH: this file is tracked in git. `scripts/stage-server-config.mjs`
# copies it to `out/.htaccess` on every build and `scripts/verify-export.mjs`
# fails the build if that copy is missing. It does not live in `deploy/` because
# that whole folder is gitignored — it holds only generated deploy artifacts,
# and nothing in this repo can regenerate this file.

AddType image/avif .avif
AddType image/webp .webp

# Never let a stale/partial RSC prefetch payload or a 404 be cached hard.
<IfModule mod_headers.c>
  # Fingerprinted build output: _next/static/**\/*.js, .css and the hashed
  # _next/static/media/**\/*.woff2 fonts all carry a content hash in the
  # filename, so they are safe to cache immutably for a year.
  <FilesMatch "\.(avif|webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML: short TTL so a redeploy is picked up quickly.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # RSC prefetch payloads + sitemap/robots: brief TTL, revalidate.
  <FilesMatch "\.(txt|xml)$">
    Header set Cache-Control "public, max-age=300, stale-while-revalidate=86400"
  </FilesMatch>

  # Security headers (conservative set — safe for a static site).
  <IfModule mod_mime.c>
    Header always set X-Content-Type-Options "nosniff"
  </IfModule>
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Force HTTPS. Hostinger usually provisions the redirect itself; this is a
# belt-and-braces fallback and is a no-op when the host already redirects.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
